# macOS
.DS_Store
**/.DS_Store

# Editor / tooling caches
.serena/
.vscode/
.idea/

# Superpowers subagent-driven-development scratch (local recovery ledger + briefs/diffs)
.superpowers/

# Node (tests use only built-ins; no deps expected, but ignore if ever added)
node_modules/
npm-debug.log*
yarn-error.log*

# Local scratch / temp
*.log
.tmp/

# --- Internal dev artifacts: kept LOCAL, not published to GitHub ---
# Test suites and fixtures (run locally with `node --test test/`)
# Exception: test/cli/** (npx-package CLI test suite) is tracked in git so
# CI/contributors can run it, but it is NOT published to npm — package.json's
# "files" field omits test/, so `npm pack`/`npx` installs never include it.
# NOTE: excludes contents of test/ (test/*) rather than the directory itself
# (test/) — git's directory-exclusion optimization skips re-descending into an
# excluded directory even for negation patterns, which silently blocks `git add`
# on any brand-new file under test/cli/ (already-tracked files are unaffected,
# which is why this only surfaces when a new test file is added).
test/*
!test/cli/
!test/cli/**
# Design docs, mockups, specs, and implementation plans
docs/
# Stray planning notes
plan.md
*.plan.md
plans/
.claude/

# SuperDesign exploration scratch (decisions captured in tokens.css comments)
.superdesign/
